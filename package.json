{
  "name": "@antelopejs/checkout-com",
  "version": "0.1.0",
  "description": "Checkout.com payments for AntelopeJS: implements the generic payment interface on the unified Payments API",
  "keywords": [
    "antelopejs",
    "checkout",
    "checkout.com",
    "payment"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/checkout-com.git"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-payment": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.17.1",
    "@antelopejs/interface-database": "^0.1.8",
    "@antelopejs/interface-subscriptions": ">=0.0.2 <0.1.0",
    "@antelopejs/mongodb": "^1.4.0",
    "@antelopejs/tooling-configs": "^0.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server-core": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-payment"
    ],
    "defaultConfig": {
      "secretKey": "your_checkout_com_secret_key",
      "processingChannelId": "your_processing_channel_id",
      "webhookSignatureKey": "your_webhook_signature_key"
    },
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
